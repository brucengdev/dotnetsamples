@page
@using Microsoft.Extensions.Options
@model IndexModel
@inject IOptionsSnapshot<TopItemsSettings> optionsAccessor
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1>Top item this month</h1>
    <p>
        @optionsAccessor.Get("Month").Name - @optionsAccessor.Get("Month").Model
    </p>
    <p>
        @optionsAccessor.Get("Year").Name - @optionsAccessor.Get("Year").Model
    </p>
</div>